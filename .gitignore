server.log
*.mp4
.claude/settings.local.json

# Auth-Daten nie ins Git (enthält Passwort-Hash, TOTP-Secret)
data/auth.json
data/logs/
data/snapshots/

# Uploads landen nicht im Git (zu groß, dynamisch)
uploads/*
!uploads/.gitkeep

# Sandbox-Inhalt nicht versionieren (nur Struktur)
sandbox/*
!sandbox/.gitkeep

# Auto-Backups vom Server
index.html.backup-*.html
index.html.bak
index.draft.html
