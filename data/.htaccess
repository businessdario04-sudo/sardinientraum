# Komplett-Sperre für /data — niemals web-zugänglich machen
# Datenstore (config.json, pages.json, auth.json, etc.)

<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2 Fallback
    Order deny,allow
    Deny from all
</IfModule>

# Fallback wenn Apache-Module fehlen: Datei-Typen explizit blockieren
<FilesMatch "\.(json|php|log|bak|txt|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
